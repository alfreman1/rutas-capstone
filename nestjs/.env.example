NODE_ENV=development
PORT=3000

# PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/logistica_db?schema=public"

# JWT Auth
JWT_SECRET="super_secret_jwt_key_example"
JWT_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="super_secret_refresh_jwt_key_example"
JWT_REFRESH_EXPIRES_IN="7d"

# Bcrypt
BCRYPT_ROUNDS=10

# Logging
LOG_LEVEL="debug"

# AI Engine Integration
AI_ENGINE_URL="http://localhost:8000"
AI_ENGINE_API_KEY="secret_key_for_ai"
AI_ENGINE_TIMEOUT_MS=300000
AI_ENGINE_MAX_RETRIES=3
AI_ENGINE_API_VERSION="v1"
