generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoGeneral {
  ACTIVO
  INACTIVO
}

enum EstadoContrato {
  BORRADOR
  ACTIVO
  FINALIZADO
  CANCELADO
}

enum EstadoJornada {
  ABIERTA
  PLANIFICADA
  EN_EJECUCION
  FINALIZADA
  CANCELADA
}

enum TipoPlanificacion {
  MANUAL
  OPTIMIZADA
  HIBRIDA
}

enum OrigenRuta {
  IA
  MANUAL
  MODIFICADA
}

enum EstadoPlanificacion {
  BORRADOR
  GENERANDO
  GENERADA
  APROBADA
  EN_EJECUCION
  FINALIZADA
  RECHAZADA
  REPLANIFICACION
  ERROR
}

enum EstadoRuta {
  PENDIENTE
  ASIGNADA
  EN_CURSO
  FINALIZADA
  CANCELADA
}

enum EstadoEntrega {
  PENDIENTE
  EN_RUTA
  ENTREGADA
  PARCIAL
  NO_ENTREGADA
  CANCELADA
}

enum TipoVehiculo {
  CAMION
  CAMIONETA
  FURGON
  OTRO
}

enum TipoEstrategiaSectorizacion {
  KMEANS
  DBSCAN
}

enum EstadoOptimizacion {
  PENDIENTE
  PROCESANDO
  COMPLETADA
  ERROR
}

model Usuario {
  id       String        @id @default(uuid())
  nombre   String
  email    String        @unique
  password String
  estado   EstadoGeneral @default(ACTIVO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios UsuarioRol[]

  @@index([estado])
  @@index([createdAt])
  @@map("usuario")
}

model Rol {
  id          String        @id @default(uuid())
  nombre      String        @unique
  descripcion String?
  estado      EstadoGeneral @default(ACTIVO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios UsuarioRol[]
  permisos RolPermiso[]

  @@map("rol")
}

model Permiso {
  id          String        @id @default(uuid())
  codigo      String        @unique
  nombre      String
  descripcion String?
  estado      EstadoGeneral @default(ACTIVO)

  roles RolPermiso[]

  @@map("permiso")
}

model UsuarioRol {
  usuarioId String
  rolId     String

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  rol     Rol     @relation(fields: [rolId], references: [id])

  @@id([usuarioId, rolId])
  @@map("usuario_rol")
}

model RolPermiso {
  rolId     String
  permisoId String

  rol     Rol     @relation(fields: [rolId], references: [id])
  permiso Permiso @relation(fields: [permisoId], references: [id])

  @@id([rolId, permisoId])
  @@map("rol_permiso")
}

model Producto {
  id          String        @id @default(uuid())
  codigo      String        @unique
  nombre      String
  descripcion String?
  estado      EstadoGeneral @default(ACTIVO)

  presentaciones  PresentacionProducto[]
  demandaDetalles DemandaDetalle[]
  stocks          Stock[]
  lotes           Lote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nombre])
  @@index([estado])
  @@map("producto")
}

model PresentacionProducto {
  id         String @id @default(uuid())
  productoId String

  nombre    String
  unidades  Int
  pesoKg    Decimal?      @db.Decimal(12, 3)
  volumenM3 Decimal?      @db.Decimal(12, 6)
  estado    EstadoGeneral @default(ACTIVO)

  producto Producto @relation(fields: [productoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productoId])
  @@map("presentacion_producto")
}

model Contrato {
  id          String  @id @default(uuid())
  codigo      String  @unique
  nombre      String
  descripcion String?

  fechaInicio DateTime
  fechaFin    DateTime?

  estado EstadoContrato @default(BORRADOR)

  puntosEntrega PuntoEntregaContrato[]
  jornadas      Jornada[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado])
  @@index([fechaInicio, fechaFin])
  @@map("contrato")
}

model PuntoEntregaContrato {
  id         String @id @default(uuid())
  contratoId String

  codigo    String
  nombre    String
  direccion String?

  latitud  Decimal @db.Decimal(10, 7)
  longitud Decimal @db.Decimal(10, 7)

  tiempoServicioMinutos Int @default(10)

  estado EstadoGeneral @default(ACTIVO)

  contrato Contrato @relation(fields: [contratoId], references: [id])

  ventanas VentanaEntrega[]
  demandas Demanda[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contratoId, codigo])
  @@index([contratoId])
  @@index([latitud, longitud])
  @@map("punto_entrega_contrato")
}

model VentanaEntrega {
  id                     String @id @default(uuid())
  puntoEntregaContratoId String

  diaSemana Int?

  horaInicio DateTime
  horaFin    DateTime

  estado EstadoGeneral @default(ACTIVO)

  puntoEntrega PuntoEntregaContrato @relation(fields: [puntoEntregaContratoId], references: [id])

  @@index([puntoEntregaContratoId])
  @@map("ventana_entrega")
}

model Jornada {
  id         String @id @default(uuid())
  contratoId String

  fecha  DateTime
  codigo String?

  estado EstadoJornada @default(ABIERTA)

  contrato Contrato @relation(fields: [contratoId], references: [id])

  demandas        Demanda[]
  planificaciones Planificacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contratoId, fecha])
  @@index([fecha])
  @@index([estado])
  @@map("jornada")
}

model Demanda {
  id                     String @id @default(uuid())
  jornadaId              String
  puntoEntregaContratoId String

  observacion String?

  jornada      Jornada              @relation(fields: [jornadaId], references: [id])
  puntoEntrega PuntoEntregaContrato @relation(fields: [puntoEntregaContratoId], references: [id])

  detalles DemandaDetalle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jornadaId, puntoEntregaContratoId])
  @@index([jornadaId])
  @@index([puntoEntregaContratoId])
  @@map("demanda")
}

model DemandaDetalle {
  id         String @id @default(uuid())
  demandaId  String
  productoId String

  cantidad Decimal @db.Decimal(12, 3)

  demanda  Demanda  @relation(fields: [demandaId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@unique([demandaId, productoId])
  @@index([productoId])
  @@map("demanda_detalle")
}

model Almacen {
  id        String  @id @default(uuid())
  codigo    String  @unique
  nombre    String
  direccion String?

  latitud  Decimal? @db.Decimal(10, 7)
  longitud Decimal? @db.Decimal(10, 7)

  estado EstadoGeneral @default(ACTIVO)

  lotes  Lote[]
  stocks Stock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("almacen")
}

model Lote {
  id         String @id @default(uuid())
  almacenId  String
  productoId String

  codigo String

  cantidad Decimal @db.Decimal(12, 3)

  fechaIngreso     DateTime
  fechaVencimiento DateTime?

  almacen  Almacen  @relation(fields: [almacenId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@unique([almacenId, codigo])
  @@index([productoId])
  @@index([fechaVencimiento])
  @@map("lote")
}

model Stock {
  id         String @id @default(uuid())
  almacenId  String
  productoId String

  cantidadDisponible Decimal @db.Decimal(12, 3)
  cantidadReservada  Decimal @default(0) @db.Decimal(12, 3)

  almacen  Almacen  @relation(fields: [almacenId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@unique([almacenId, productoId])
  @@map("stock")
}

model Vehiculo {
  id String @id @default(uuid())

  placa  String  @unique
  codigo String  @unique
  marca  String?
  modelo String?

  tipo TipoVehiculo

  capacidadPesoKg    Decimal? @db.Decimal(12, 3)
  capacidadVolumenM3 Decimal? @db.Decimal(12, 6)

  estado EstadoGeneral @default(ACTIVO)

  planificaciones Planificacion[]
  cargas          Carga[]
  rutas           Ruta[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado])
  @@map("vehiculo")
}

model Planificacion {
  id         String  @id @default(uuid())
  jornadaId  String
  vehiculoId String?

  codigo String?           @unique
  tipo   TipoPlanificacion @default(MANUAL)

  fechaGeneracion DateTime @default(now())

  estado EstadoPlanificacion @default(BORRADOR)

  estrategiaSectorizacion TipoEstrategiaSectorizacion?

  optimizacionSeleccionadaId String?   @unique
  creadoPorId                String?
  aprobadoPorId              String?
  fechaAprobacion            DateTime?

  jornada  Jornada   @relation(fields: [jornadaId], references: [id])
  vehiculo Vehiculo? @relation(fields: [vehiculoId], references: [id])

  sectores                 Sector[]
  cargas                   Carga[]
  rutas                    Ruta[]
  optimizaciones           Optimizacion[] @relation("PlanificacionOptimizaciones")
  optimizacionSeleccionada Optimizacion?  @relation("OptimizacionSeleccionada", fields: [optimizacionSeleccionadaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jornadaId])
  @@index([estado])
  @@map("planificacion")
}

model Sector {
  id              String @id @default(uuid())
  planificacionId String

  codigo String

  algoritmo TipoEstrategiaSectorizacion

  centroLatitud  Decimal? @db.Decimal(10, 7)
  centroLongitud Decimal? @db.Decimal(10, 7)

  parametros Json?

  planificacion Planificacion @relation(fields: [planificacionId], references: [id])

  puntos SectorPunto[]

  @@unique([planificacionId, codigo])
  @@map("sector")
}

model SectorPunto {
  id             String @id @default(uuid())
  sectorId       String
  puntoEntregaId String

  sector Sector @relation(fields: [sectorId], references: [id])

  @@index([sectorId])
  @@index([puntoEntregaId])
  @@map("sector_punto")
}

model Carga {
  id              String @id @default(uuid())
  planificacionId String
  vehiculoId      String

  pesoTotalKg    Decimal @default(0) @db.Decimal(12, 3)
  volumenTotalM3 Decimal @default(0) @db.Decimal(12, 6)

  vehiculo      Vehiculo      @relation(fields: [vehiculoId], references: [id])
  planificacion Planificacion @relation(fields: [planificacionId], references: [id])

  rutas Ruta[]

  createdAt DateTime @default(now())

  @@index([planificacionId])
  @@index([vehiculoId])
  @@map("carga")
}

model Ruta {
  id              String  @id @default(uuid())
  planificacionId String
  optimizacionId  String?
  cargaId         String?
  vehiculoId      String

  codigo String
  numero Int?

  origen OrigenRuta @default(IA)

  ordenGenerado Int?

  distanciaKm   Decimal? @db.Decimal(12, 3)
  tiempoMinutos Int?

  cargaCajas   Int?
  cargaPeso    Decimal? @db.Decimal(12, 3)
  cargaVolumen Decimal? @db.Decimal(12, 6)

  estado EstadoRuta @default(PENDIENTE)

  planificacion Planificacion @relation(fields: [planificacionId], references: [id])
  optimizacion  Optimizacion? @relation(fields: [optimizacionId], references: [id])
  carga         Carga?        @relation(fields: [cargaId], references: [id])
  vehiculo      Vehiculo      @relation(fields: [vehiculoId], references: [id])

  entregas Entrega[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planificacionId])
  @@index([vehiculoId])
  @@index([estado])
  @@map("ruta")
}

model Entrega {
  id String @id @default(uuid())

  rutaId         String
  puntoEntregaId String
  demandaId      String?

  orden Int

  horaEstimadaLlegada String?
  horaEstimadaSalida  String?

  distanciaKm           Decimal? @db.Decimal(12, 3)
  tiempoEstimadoMinutos Int?

  estado EstadoEntrega @default(PENDIENTE)

  ruta Ruta @relation(fields: [rutaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rutaId, orden])
  @@index([puntoEntregaId])
  @@index([demandaId])
  @@map("entrega")
}

model Optimizacion {
  id              String @id @default(uuid())
  planificacionId String

  version   Int    @default(1)
  algoritmo String

  parametros   Json?
  resultado    Json?
  resultadoRaw Json?

  distanciaInicialKm Decimal? @db.Decimal(12, 3)
  distanciaFinalKm   Decimal? @db.Decimal(12, 3)

  tiempoInicialMinutos Int?
  tiempoFinalMinutos   Int?

  vehiculosUtilizados Int?

  mejoraDistanciaPorcentaje Decimal? @db.Decimal(8, 3)

  estado EstadoOptimizacion @default(PENDIENTE)

  iniciadoAt        DateTime?
  finalizadoAt      DateTime?
  tiempoEjecucionMs Int?

  planificacion             Planificacion  @relation("PlanificacionOptimizaciones", fields: [planificacionId], references: [id])
  planificacionSeleccionada Planificacion? @relation("OptimizacionSeleccionada")

  rutasGeneradas Ruta[]

  createdAt DateTime @default(now())

  @@index([planificacionId])
  @@index([estado])
  @@map("optimizacion")
}
